{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp.ReverseProxy": "Information"
    }
  },

  "AllowedHosts": "*",

  "ReverseProxy": {
    "Routes": {
      "ingestion": {
        "ClusterId": "ingestion-cluster",
        "Match": {
          "Path": "/api/ingest/{**catch-all}"
        }
      },

      "reports": {
        "ClusterId": "ingestion-cluster",
        "Match": {
          "Path": "/api/reports/{**catch-all}"
        }
      },

      "notifications-api": {
        "ClusterId": "notification-cluster",
        "Match": {
          "Path": "/api/notify/{**catch-all}"
        }
      },

      "signalr": {
        "ClusterId": "notification-cluster",
        "Match": {
          "Path": "/hub/{**catch-all}"
        }
      }
    },

    "Clusters": {
      "ingestion-cluster": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5292/"
          }
        }
      },

      "notification-cluster": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5048/"
          }
        }
      }
    }
  }
}